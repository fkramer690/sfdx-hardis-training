<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description>Refuses to close when the checklist cannot be read, rather than letting an unchecked job through.</description>
        <name>Handover_Check_Failed</name>
        <label>Handover Check Failed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>The handover checklist could not be checked. Try again, or ask an administrator.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <description>Refuses to close an installation while a handover item is not done.</description>
        <name>Handover_Incomplete</name>
        <label>Handover Incomplete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Finish the handover checklist before closing this installation.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <description>Refuses to close an installation that was never given an install date.</description>
        <name>Install_Date_Missing</name>
        <label>Install Date Missing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Set the install date before closing this installation.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Was the installation ever given an install date?</description>
        <name>No_Install_Date</name>
        <label>No Install Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Open_Handover_Item</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Install date set</defaultConnectorLabel>
        <rules>
            <name>Date_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Install_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Install_Date_Missing</targetReference>
            </connector>
            <label>Date missing</label>
        </rules>
    </decisions>
    <decisions>
        <description>Was an item of this installation found that is not done yet?</description>
        <name>Open_Item_Found</name>
        <label>Open Item Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Checklist complete</defaultConnectorLabel>
        <rules>
            <name>Item_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>openHandoverItem</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Handover_Incomplete</targetReference>
            </connector>
            <label>Item open</label>
        </rules>
    </decisions>
    <description>An installation cannot be closed without an install date, or while its handover checklist has an item that is not done.</description>
    <environments>Default</environments>
    <interviewLabel>Installation Close Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Installation Close Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Looks for one handover item of this installation that is not done.</description>
        <name>Get_Open_Handover_Item</name>
        <label>Get Open Handover Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Open_Item_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Handover_Check_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Installation__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Done__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Handover_Item__c</object>
        <outputReference>openHandoverItem</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>No_Install_Date</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <object>Installation__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>The first handover item of the installation that is not done, if any.</description>
        <name>openHandoverItem</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Handover_Item__c</objectType>
    </variables>
</Flow>
